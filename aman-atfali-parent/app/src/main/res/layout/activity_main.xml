<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#F5F8FC" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="vertical" android:padding="22dp" android:layoutDirection="rtl">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="أمان أطفالي" android:textSize="32sp" android:textStyle="bold" android:textColor="#102A43"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="لوحة وليّ الأمر" android:textSize="17sp" android:textColor="#2563EB" android:layout_marginTop="4dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="اربط جهاز طفلك بسهولة ثم تابع موقعه من التطبيق." android:textSize="14sp"
   android:textColor="#64748B" android:layout_marginTop="10dp"/>

  <EditText android:id="@+id/serverUrl" android:layout_width="match_parent" android:layout_height="54dp"
   android:hint="رابط موقع WordPress" android:inputType="textUri"
   android:text="https://www.chaibcalligraphy.com" android:layout_marginTop="22dp"/>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="1 — ربط جهاز الطفل" android:textSize="20sp" android:textStyle="bold"
   android:textColor="#102A43" android:layout_marginTop="24dp"/>

  <Button android:id="@+id/scanButton" android:layout_width="match_parent" android:layout_height="56dp"
   android:text="📷  مسح QR بالكاميرا" android:textSize="16sp" android:layout_marginTop="12dp"/>

  <Button android:id="@+id/galleryButton" android:layout_width="match_parent" android:layout_height="56dp"
   android:text="🖼  اختيار QR من معرض الهاتف" android:textSize="16sp" android:layout_marginTop="10dp"/>

  <TextView android:id="@+id/scanResult" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="لم يتم ربط طفل بعد" android:textSize="17sp" android:textStyle="bold"
   android:textColor="#102A43" android:gravity="center" android:padding="18dp"
   android:layout_marginTop="16dp" android:background="#FFFFFF"/>

  <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="بانتظار الربط" android:textSize="14sp" android:textColor="#64748B"
   android:gravity="center" android:padding="14dp"/>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="2 — متابعة الطفل" android:textSize="20sp" android:textStyle="bold"
   android:textColor="#102A43" android:layout_marginTop="18dp"/>

  <Button android:id="@+id/mapButton" android:layout_width="match_parent" android:layout_height="56dp"
   android:text="📍 عرض موقع الطفل والمسار" android:textSize="16sp" android:enabled="false"
   android:layout_marginTop="10dp"/>

  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="يمكنك مسح QR مباشرة بالكاميرا أو اختيار صورة QR محفوظة في الهاتف."
   android:textSize="12sp" android:textColor="#64748B" android:gravity="center"
   android:layout_marginTop="20dp"/>
 </LinearLayout>
</ScrollView>